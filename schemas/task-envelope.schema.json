{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task-envelope.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "template_version",
    "identity",
    "task_type",
    "mode",
    "markdown_path",
    "markdown_sha256",
    "inputs",
    "retry"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "project_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "template_version": {"type": "string"},
    "identity": {
      "type": "object",
      "required": ["run_id", "task_id", "prompt_id"],
      "additionalProperties": false,
      "properties": {
        "run_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "task_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "prompt_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
      }
    },
    "task_type": {"const": "book_video"},
    "mode": {"const": "unattended"},
    "markdown_path": {"type": "string"},
    "markdown_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "inputs": {"type": "object"},
    "retry": {"type": "object"}
  },
  "additionalProperties": false
}
