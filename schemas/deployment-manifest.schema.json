{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deployment-manifest.schema.json",
  "type": "object",
  "required": ["schema_version", "deployment_id", "project_id", "remote_root", "entries"],
  "properties": {
    "schema_version": {"const": 1},
    "deployment_id": {"type": "string", "pattern": "^DEP-[0-9]{8}-[0-9]{6}$"},
    "project_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "remote_root": {"type": "string", "pattern": "^/"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_path", "remote_path", "mode"],
        "properties": {
          "source_path": {"type": "string"},
          "remote_path": {"type": "string"},
          "mode": {"enum": ["auto", "manual", "remote_existing", "ignore"]},
          "size_bytes": {"type": ["integer", "null"], "minimum": 0},
          "sha256": {"type": ["string", "null"]},
          "expected_remote_sha256": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
